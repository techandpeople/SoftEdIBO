{
  "format": "softedibo.activity",
  "version": 1,
  "name": "Skin Organ (rectangle) — study timeline",
  "description": "Organ (rectangle) skin, 3 timed phases (advances by time, or manually with Prev/Next phase). Phase 1 (0:00): purple, rhythmic low-energy movement, one chamber at a time. Phase 2 (after 2 min): half purple / half yellow, aligned beat — 2 chambers strong, 1 soft. Phase 3 (after a further 5 min): yellow, rhythmic beat with all 3 chambers together. Pump duty sets the beat's energy.",
  "spec": {
    "initial": "phase1",
    "states": {
      "phase1": {
        "do": [
          { "set_led": { "color": "#8e44ad", "pattern": "solid", "period_ms": 0 } },
          { "repeat": { "forever": true, "do": [
            { "beat": { "mode": "sequential", "pct": 55, "period_ms": 3500, "duty": 140 } }
          ] } }
        ],
        "on_touch": [],
        "transitions": [
          { "to": "phase2", "when": { "elapsed_ms": 120000 } }
        ]
      },
      "phase2": {
        "do": [
          { "set_led_halves": { "colors": ["#8e44ad", "#f1c40f"], "pattern": "solid", "period_ms": 0 } },
          { "repeat": { "forever": true, "do": [
            { "beat": { "mode": "aligned", "pct": 60, "pct2": 20, "aligned": 2, "period_ms": 2500, "duty": 170 } }
          ] } }
        ],
        "on_touch": [],
        "transitions": [
          { "to": "phase3", "when": { "elapsed_ms": 300000 } }
        ]
      },
      "phase3": {
        "do": [
          { "set_led": { "color": "#f1c40f", "pattern": "solid", "period_ms": 0 } },
          { "repeat": { "forever": true, "do": [
            { "beat": { "mode": "sync", "pct": 60, "period_ms": 2000, "duty": 230 } }
          ] } }
        ],
        "on_touch": [],
        "transitions": []
      }
    }
  }
}
