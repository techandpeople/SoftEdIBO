# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# pyenv
.python-version

# Tests & coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.coveragerc

# Generated UI Python files (from pyside6-uic — source of truth is src/gui/ui/*.ui)
src/gui/ui_*.py

# IDE
.vscode/*
!.vscode/c_cpp_properties.json
.idea/
*.swp
*.swo
*.iml

# Data files
data/*.db
data/*.sqlite
data/*.log
data/.setup_done

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment variables
.env
.env.*

# PlatformIO build artifacts
firmware/**/.pio/
firmware/**/libdeps/
firmware/**/.pioenvs/
firmware/*/firmware*.bin
firmware/*/compile_commands.json

# Vendored Blockly for the Behaviour Editor (fetch via scripts/fetch_blockly.sh).
# Editor falls back to the CDN when absent; bundle/CI can vendor it on demand.
src/gui/blockly/blockly.min.js
src/gui/blockly/media/

# Thymio 802.15.4 capture artifacts (throwaway; produced by scripts/thymio_sniff_*)
cap*.jsonl
capture_*.jsonl
*.pcap

# KiCad throwaways (hardware/PCB/). The auto-backup zips alone were 89 MB and
# every save adds another, so they must never be committed — the .kicad_* source
# files are the record. fp-info-cache is regenerated on demand.
*-backups/
_autosave-*
*.kicad_*-bak
*.kicad_prl
fp-info-cache
~*.lck
