# 1. The Lean Base
FROM docker.io/library/debian:bookworm-slim

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# 2. Surgical Physics Engine Install (Debian handles CSXCAD bindings automatically)
RUN apt-get update && apt-get install -y --no-install-recommends \
  openems \
  python3-openems \
  curl \
  ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# 3. Inject Astral's `uv`
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# 4. Build the Python Environment OUTSIDE the mount point
# This prevents your HDD bind-mount from overwriting the container's venv
RUN uv venv --system-site-packages /opt/venv && \
  VIRTUAL_ENV=/opt/venv uv pip install "numpy<2" scipy h5py matplotlib

# 5. Workspace Setup
WORKDIR /sim_engine

# 6. Execute using the isolated environment
ENTRYPOINT ["/opt/venv/bin/python"]
