<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>OTAUpdateDialog</class>
 <widget class="QDialog" name="OTAUpdateDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>680</width><height>420</height></rect>
  </property>
  <property name="windowTitle"><string>Update Nodes (OTA)</string></property>
  <property name="minimumSize">
   <size><width>680</width><height>420</height></size>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="instructions_label">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>Flash node firmware wirelessly through the gateway. The gateway must stay connected by USB; only the nodes are updated over the air.</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="banner_label">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string/></property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="debug_check">
     <property name="whatsThis"><string>Flash the debug firmware instead of the release build. Debug adds verbose Serial logging; use it for troubleshooting, the release build for normal use.</string></property>
     <property name="text"><string>Debug build (verbose Serial output)</string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="transport_row">
     <item>
      <widget class="QLabel" name="transport_label">
       <property name="text"><string>Transport:</string></property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="transport_combo">
       <property name="whatsThis"><string>How the firmware reaches the node. ESP-NOW is slow but works anywhere the gateway can reach the node. WiFi is far faster (seconds instead of minutes): the PC streams the image to the gateway over USB and the gateway serves it to the node over its WiFi access point. Needs the S3 access-point build; the PC stays on the cable.</string></property>
       <item><property name="text"><string>ESP-NOW (reliable, slow)</string></property></item>
       <item><property name="text"><string>WiFi (fast, needs gateway AP)</string></property></item>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="ap_ssid_label">
       <property name="text"><string>AP network:</string></property>
      </widget>
     </item>
     <item>
      <widget class="QLineEdit" name="ap_ssid_edit">
       <property name="whatsThis"><string>Name (SSID) of the gateway's WiFi access point the node joins to download the firmware. Default "SoftEdIBO". The node connects to it; the PC does not.</string></property>
       <property name="text"><string>SoftEdIBO</string></property>
      </widget>
     </item>
     <item>
      <widget class="QLabel" name="ap_pass_label">
       <property name="text"><string>Password:</string></property>
      </widget>
     </item>
     <item>
      <widget class="QLineEdit" name="ap_pass_edit">
       <property name="whatsThis"><string>Password of the gateway's WiFi access point. Default "softedibo". Used by the node to join the AP; leave the default unless you changed it in Tools → Gateway WiFi AP….</string></property>
       <property name="echoMode"><enum>QLineEdit::Password</enum></property>
       <property name="text"><string>softedibo</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="wifi_hint_label">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>WiFi OTA (fast): needs the gateway's S3 access-point build (Tools → Flash Firmware). The PC stays on the USB cable — it streams the image to the gateway, which serves it to the node over WiFi.</string></property>
    </widget>
   </item>
   <item>
    <widget class="QTableWidget" name="table">
     <property name="whatsThis"><string>Configured nodes and whether each is reachable over ESP-NOW. Tick the ones to update; Progress and Status fill in during flashing. Only online nodes can be flashed.</string></property>
     <column><property name="text"><string/></property></column>
     <column><property name="text"><string>MAC</string></property></column>
     <column><property name="text"><string>Type</string></property></column>
     <column><property name="text"><string>Online</string></property></column>
     <column><property name="text"><string>Progress</string></property></column>
     <column><property name="text"><string>Status</string></property></column>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="button_row">
     <item>
      <widget class="QPushButton" name="select_all_btn">
       <property name="whatsThis"><string>Tick every node currently shown as online.</string></property>
       <property name="text"><string>Select online</string></property>
      </widget>
     </item>
     <item>
      <spacer name="button_spacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="flash_btn">
       <property name="whatsThis"><string>Start the over-the-air update for the ticked nodes. Keep the gateway connected and the nodes powered until it finishes — interrupting a flash can brick a node.</string></property>
       <property name="text"><string>Flash selected</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="close_btn">
       <property name="text"><string>Close</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
