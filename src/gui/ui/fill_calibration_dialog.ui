  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="intro_label">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>Inflates each chamber from empty in fixed time steps, reading the pressure after each step, to measure its time→pressure fill curve. The curve is saved per chamber and used instead of live pressure control. Re-run with a smaller step to refine. Keep hands clear.</string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="controls_row">
     <item>
      <widget class="QLabel" name="step_label">
       <property name="text"><string>Step size:</string></property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="step_combo">
       <property name="whatsThis"><string>Inflate-step granularity for the sweep. Coarse is fast; finer steps measure more points on the curve. Re-run a chamber with a finer step to refine its curve.</string></property>
      </widget>
     </item>
     <item>
      <spacer name="controls_spacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QScrollArea" name="scroll_area">
     <property name="widgetResizable"><bool>true</bool></property>
     <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
     <widget class="QWidget" name="rows_container">
      <layout class="QVBoxLayout" name="rows_layout">
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="button_row">
     <item>
      <widget class="QPushButton" name="all_btn">
       <property name="whatsThis"><string>Run the timing sweep for every chamber in turn. Each is inflated from empty to its max while the sensor times it. Keep hands clear during the run.</string></property>
       <property name="text"><string>Calibrate all</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="stop_btn">
       <property name="whatsThis"><string>Abort the current calibration immediately and halt every chamber (close valves, pumps off). Does not run the vacuum pump.</string></property>
       <property name="text"><string>⏹ Stop</string></property>
      </widget>
     </item>
     <item>
      <spacer name="button_spacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="save_btn">
       <property name="whatsThis"><string>Store the measured fill curves into the skin so the activity can use timed filling instead of live pressure control.</string></property>
       <property name="text"><string>Save</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
