<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>FillCalibrationDialog</class>
 <widget class="QDialog" name="FillCalibrationDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>600</width><height>420</height></rect>
  </property>
  <property name="windowTitle"><string>Calibrate Fill Times</string></property>
  <property name="minimumSize">
   <size><width>560</width><height>0</height></size>
  </property>
  <property name="maximumSize">
   <size><width>720</width><height>16777215</height></size>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="intro_label">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>Inflates each chamber from empty while streaming pressure, to measure its time→pressure fill curve in one continuous pass. Curves are saved per chamber and used instead of live pressure control, and rank which chamber fills first. "Calibrate all" sweeps every chamber. Keep hands clear.</string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="controls_row">
     <item>
      <widget class="QLabel" name="detail_label">
       <property name="text"><string>Detail:</string></property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="detail_combo">
       <property name="whatsThis"><string>How densely to sample the fill curve — the live telemetry cadence during the sweep. Finer captures more points on the curve at the cost of a little more radio traffic.</string></property>
      </widget>
     </item>
     <item>
      <spacer name="controls_spacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QLabel" name="combo_status">
       <property name="whatsThis"><string>Progress of a "Calibrate all" run: which chamber sweep is in progress out of the total, and which node/slot it covers.</string></property>
       <property name="text"><string/></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QScrollArea" name="scroll_area">
     <property name="widgetResizable"><bool>true</bool></property>
     <property name="horizontalScrollBarPolicy"><enum>Qt::ScrollBarAlwaysOff</enum></property>
     <widget class="QWidget" name="rows_container">
      <layout class="QVBoxLayout" name="rows_layout">
       <property name="leftMargin"><number>0</number></property>
       <property name="topMargin"><number>0</number></property>
       <property name="rightMargin"><number>0</number></property>
       <property name="bottomMargin"><number>0</number></property>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="button_row">
     <item>
      <widget class="QPushButton" name="all_btn">
       <property name="whatsThis"><string>Run the continuous timing sweep for every configured chamber, one at a time from empty. Keep hands clear during the run.</string></property>
       <property name="text"><string>Calibrate all</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="duty_btn">
       <property name="whatsThis"><string>Measure each chamber's pump duty→fill-speed curve: sweep it from empty at several PWM duties and record how much slower a lower duty fills. Lets the "over (ms)" slow-fill pick the right duty from measured data instead of a rough estimate. Keep hands clear during the run.</string></property>
       <property name="text"><string>Duty curves</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="deflate_btn">
       <property name="whatsThis"><string>Measure each chamber's deflate (vacuum) curve: fill it, then hold the deflate valve open while recording the falling pressure until it stops dropping — the sensor's floor. Times deflates the gauge cannot supervise (targets at or below the floor, e.g. wrinkles), so the vacuum pull ends deterministically. Keep hands clear during the run.</string></property>
       <property name="text"><string>Deflate curves</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="stop_btn">
       <property name="whatsThis"><string>Abort the current calibration immediately and halt every chamber (close valves, pumps off). Does not run the vacuum pump.</string></property>
       <property name="text"><string>⏹ Stop</string></property>
      </widget>
     </item>
     <item>
      <widget class="QCheckBox" name="save_type_check">
       <property name="whatsThis"><string>Save each measured curve as the template for its skin type + silicone (e.g. tree_round_organ), shared by every skin of that type, instead of onto just this physical chamber. Chambers with a type inherit the template; leave off to save a per-chamber override.</string></property>
       <property name="text"><string>Save as skin-type template</string></property>
       <property name="checked"><bool>true</bool></property>
      </widget>
     </item>
     <item>
      <spacer name="button_spacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="apply_btn">
       <property name="whatsThis"><string>Store the measured fill curves into the skin without closing this window, so you can keep refining other chambers. Same as Save but leaves the dialog open.</string></property>
       <property name="text"><string>Apply</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="save_btn">
       <property name="whatsThis"><string>Store the measured fill curves into the skin so the activity can use timed filling instead of live pressure control, and close this window.</string></property>
       <property name="text"><string>Save</string></property>
       <property name="default"><bool>true</bool></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
