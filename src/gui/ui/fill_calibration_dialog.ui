 <class>FillCalibrationDialog</class>
 <widget class="QDialog" name="FillCalibrationDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>600</width><height>420</height></rect>
  </property>
  <property name="windowTitle"><string>Calibrate Fill Times</string></property>
  <property name="minimumSize">
   <size><width>560</width><height>0</height></size>
