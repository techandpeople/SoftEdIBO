<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TestActuatorsDialog</class>
 <widget class="QDialog" name="TestActuatorsDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>820</width><height>640</height></rect>
  </property>
  <property name="windowTitle"><string>Test Actuators</string></property>
  <property name="minimumSize">
   <size><width>600</width><height>560</height></size>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <!-- The left column holds an Expanding scroll area, so the QHBoxLayout gives
         it the extra horizontal space and the right (sensor) column keeps its
         natural width - no explicit stretch factor needed. -->
    <layout class="QHBoxLayout" name="content_row">
     <item>
      <!-- Left column: chambers + actuator controls (grows to fill width). -->
      <layout class="QVBoxLayout" name="left_col">
       <item>
        <widget class="QLabel" name="no_chambers_label">
         <property name="text"><string>No air chambers configured for this node.</string></property>
         <property name="visible"><bool>false</bool></property>
        </widget>
       </item>
       <item>
        <widget class="QScrollArea" name="chambers_scroll">
         <property name="sizePolicy">
          <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
           <horstretch>0</horstretch>
           <verstretch>1</verstretch>
          </sizepolicy>
         </property>
         <property name="minimumSize">
          <size><width>0</width><height>240</height></size>
         </property>
         <property name="whatsThis"><string>One row per chamber. Use the inflate/deflate controls to drive each chamber by hand and confirm the wiring matches the layout. Keep hands clear of the actuators.</string></property>
         <property name="widgetResizable"><bool>true</bool></property>
         <property name="visible"><bool>false</bool></property>
         <widget class="QWidget" name="chambers_content">
          <layout class="QVBoxLayout" name="chambers_vbox"/>
         </widget>
        </widget>
       </item>
       <item>
        <widget class="QCheckBox" name="cont_cb">
         <property name="text"><string>Ignore max pressure - per-chamber Inflate/Deflate runs until stopped</string></property>
         <property name="visible"><bool>false</bool></property>
         <property name="whatsThis"><string>While checked, a chamber's Inflate or Deflate button toggles a continuous run of that one chamber: it opens the matching valve and drives the pump, ignoring the configured max/min pressure, until you press the button (now  Stop) again. While unchecked, those buttons do a one-shot fill toward the configured max/min.</string></property>
        </widget>
       </item>
       <!-- The LED ring tester(s) are inserted here at runtime (before pump_group)
            because their count/size is only known from the node config. -->
       <item>
        <widget class="QGroupBox" name="pump_group">
         <property name="title"><string>Pump Control</string></property>
         <layout class="QHBoxLayout" name="pump_layout">
          <item>
           <widget class="QPushButton" name="pump_inf_btn">
            <property name="maximumSize"><size><width>160</width><height>16777215</height></size></property>
            <property name="styleSheet"><string notr="true">font-family: Courier; font-size: 10pt;</string></property>
            <property name="text"><string>Inflate Pump: OFF</string></property>
            <property name="whatsThis"><string>Toggle the inflate pump on/off directly (bench test). The label flips on click, but the GREEN fill only appears when the node reports the pump ACTUALLY running (~2x/s) - so it lights up whoever runs it, including when you press a chamber's Inflate (the pump runs for the fill), not just this manual toggle. The firmware auto-closes a manually driven pump after ~5 s unless the dialog keeps re-asserting it, so it stops on its own if the link drops.</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="pump_def_btn">
            <property name="maximumSize"><size><width>160</width><height>16777215</height></size></property>
            <property name="styleSheet"><string notr="true">font-family: Courier; font-size: 10pt;</string></property>
            <property name="text"><string>Deflate Pump: OFF</string></property>
            <property name="whatsThis"><string>Toggle the deflate pump on/off directly (bench test). The label flips on click, but the GREEN fill only appears when the node reports the pump ACTUALLY running (~2x/s) - so it lights up whoever runs it, including when you press a chamber's Deflate (the pump runs for the fill), not just this manual toggle. The firmware auto-closes a manually driven pump after ~5 s unless the dialog keeps re-asserting it, so it stops on its own if the link drops.</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="vent_btn">
            <property name="minimumSize"><size><width>150</width><height>0</height></size></property>
            <property name="maximumSize"><size><width>150</width><height>16777215</height></size></property>
            <property name="styleSheet"><string notr="true">font-family: Courier; font-size: 10pt;</string></property>
            <property name="text"><string>Vent</string></property>
            <property name="toolTip"><string>Vent every chamber to atmosphere (no pump), alternating deflate/inflate. Press again to close.</string></property>
            <property name="whatsThis"><string>Bring every chamber to atmosphere with no pump. It ALTERNATES each chamber's deflate and inflate valve every ~2 s: with the pumps off, each manifold's path to atmosphere (through its own off pump) is one-way, so the deflate side lets an inflated chamber bleed OUT and the inflate side lets a vacuumed one draw air IN - and this board only allows one side open at a time, hence the alternation. No pump runs, so nothing is pressurised. Press again to close (both sides), or use STOP ALL / close the dialog. Use it to bring the skin to true rest before zeroing the sensors.</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="stop_all_btn">
            <property name="styleSheet"><string notr="true">background-color: #FF6B6B; font-weight: bold;</string></property>
            <property name="text"><string> STOP ALL (Close valves + Off pumps)</string></property>
            <property name="whatsThis"><string>Cut both pumps, close every valve, clear manual overrides and reset every chamber to idle, then LATCH the node off. The node stays off until the next actuation re-arms it, so a single delivered stop frame holds even if a later frame drops.</string></property>
           </widget>
          </item>
          <item>
           <spacer name="pump_spacer">
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
           </spacer>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="run_group">
         <property name="title"><string>Continuous Run (ignores pressure)</string></property>
         <property name="whatsThis"><string>Drive one pump and all of its valves wide open indefinitely, ignoring the pressure reading and the firmware dead-man timeout. Use this to check pump/valve wiring when the pressure sensor reads wrong. Press the active button again, STOP ALL, or close the dialog to stop.</string></property>
         <layout class="QHBoxLayout" name="run_layout">
          <item>
           <widget class="QPushButton" name="run_inf_btn">
            <property name="styleSheet"><string notr="true">font-family: Courier; font-size: 10pt;</string></property>
            <property name="text"><string>Run Inflate inf: OFF</string></property>
            <property name="whatsThis"><string>Turn the inflate pump on and open every inflate valve, and keep them on until stopped. Ignores pressure limits.</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="run_def_btn">
            <property name="styleSheet"><string notr="true">font-family: Courier; font-size: 10pt;</string></property>
            <property name="text"><string>Run Deflate inf: OFF</string></property>
            <property name="whatsThis"><string>Turn the deflate pump on and open every deflate valve, and keep them on until stopped. Ignores pressure limits.</string></property>
           </widget>
          </item>
          <item>
           <spacer name="run_spacer">
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
           </spacer>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </item>
     <item>
      <!-- Right column: the touch/magnet sensor tester is inserted here at
           runtime (its sensor count is only known from the first magnet frame).
           Empty and near-zero width until then; the spacer pins it to the top. -->
      <layout class="QVBoxLayout" name="right_col">
       <item>
        <spacer name="right_col_spacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
         <property name="sizeHint" stdset="0"><size><width>0</width><height>20</height></size></property>
        </spacer>
       </item>
      </layout>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="close_row">
     <item>
      <spacer name="close_spacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="close_btn">
       <property name="text"><string>Close</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
