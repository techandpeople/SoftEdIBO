<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>TouchCalibrationDialog</class>
 <widget class="QDialog" name="TouchCalibrationDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>600</width><height>480</height></rect>
  </property>
  <property name="windowTitle"><string>Calibrate Touch ↔ Chamber Coupling</string></property>
  <property name="minimumSize">
   <size><width>560</width><height>0</height></size>
  </property>
  <property name="maximumSize">
   <size><width>760</width><height>16777215</height></size>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="intro_label">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string>Inflating a chamber shifts the magnet over each touch sensor, which can fake a touch. This sweep inflates each chamber alone through a staircase of levels, reads how much it moves every sensor (in µT) at each level, and stores that as per-chamber compensation curves that are subtracted from the live reading. Run it once per skin, without touching the skin. Keep hands clear.</string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="skin_row">
     <item>
      <widget class="QLabel" name="skin_label">
       <property name="text"><string>Skin:</string></property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="skin_combo">
       <property name="whatsThis"><string>Which skin to calibrate. Only skins whose touch node can stream magnet data are listed.</string></property>
      </widget>
     </item>
     <item>
      <spacer name="skin_spacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QProgressBar" name="progress">
     <property name="value"><number>0</number></property>
     <property name="whatsThis"><string>Sweep progress across the skin's chambers.</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="status_label">
     <property name="text"><string>Idle.</string></property>
    </widget>
   </item>
   <item>
    <widget class="QPlainTextEdit" name="preview">
     <property name="readOnly"><bool>true</bool></property>
     <property name="whatsThis"><string>Measured coupling matrix: per chamber, the µT shift it causes on each sensor. Larger numbers mean stronger contamination.</string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="tuning_row">
     <item>
      <widget class="QCheckBox" name="enable_check">
       <property name="text"><string>Enable compensation after saving</string></property>
       <property name="checked"><bool>true</bool></property>
       <property name="whatsThis"><string>Subtract the measured matrix from the live touch readings during sessions. Turn off to store the matrix without applying it yet.</string></property>
      </widget>
     </item>
     <item>
      <spacer name="tuning_spacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QLabel" name="threshold_label">
       <property name="text"><string>Touch threshold (µT):</string></property>
      </widget>
     </item>
     <item>
      <widget class="QSpinBox" name="threshold_spin">
       <property name="minimum"><number>10</number></property>
       <property name="maximum"><number>5000</number></property>
       <property name="singleStep"><number>10</number></property>
       <property name="value"><number>300</number></property>
       <property name="whatsThis"><string>After compensation, a sensor counts as touched when its residual reaches this many µT. Lower = more sensitive.</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="advanced_row">
     <item>
      <widget class="QLabel" name="levels_label">
       <property name="text"><string>Levels per chamber:</string></property>
      </widget>
     </item>
     <item>
      <widget class="QSpinBox" name="levels_spin">
       <property name="minimum"><number>1</number></property>
       <property name="maximum"><number>5</number></property>
       <property name="value"><number>4</number></property>
       <property name="whatsThis"><string>How many inflation levels to hold per chamber during the sweep (evenly spaced up to 100 %). More levels capture the nonlinear silicone response as a curve, so compensation is accurate at partial inflation too; 1 reproduces the old full-inflation-only matrix. 4 ≈ 25/50/75/100 %.</string></property>
      </widget>
     </item>
     <item>
      <spacer name="advanced_spacer1">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QLabel" name="margin_label">
       <property name="text"><string>Margin:</string></property>
      </widget>
     </item>
     <item>
      <widget class="QSpinBox" name="margin_spin">
       <property name="minimum"><number>0</number></property>
       <property name="maximum"><number>100</number></property>
       <property name="singleStep"><number>5</number></property>
       <property name="value"><number>25</number></property>
       <property name="suffix"><string> %</string></property>
       <property name="whatsThis"><string>Safety margin: raise a sensor's touch threshold by this fraction of the correction applied to it. Big corrections carry proportionally bigger calibration error, so this stops them flipping a sensor active on their own. 0 disables the margin (old behaviour).</string></property>
      </widget>
     </item>
     <item>
      <spacer name="advanced_spacer2">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QLabel" name="guard_label">
       <property name="text"><string>Transition guard:</string></property>
      </widget>
     </item>
     <item>
      <widget class="QSpinBox" name="guard_spin">
       <property name="minimum"><number>0</number></property>
       <property name="maximum"><number>3000</number></property>
       <property name="singleStep"><number>100</number></property>
       <property name="value"><number>800</number></property>
       <property name="suffix"><string> ms</string></property>
       <property name="specialValueText"><string>off</string></property>
       <property name="whatsThis"><string>For this long after a chamber's level changes, harden the threshold of the sensors coupled to it (by that chamber's strongest measured offset). The calibration only measures steady state, so during transitions — pump running, pressure readings lagging — the compensation is least reliable and ghost touches are most likely. 0 turns the guard off.</string></property>
      </widget>
     </item>
     <item>
      <spacer name="advanced_spacer3">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="suppress_row">
     <item>
      <widget class="QCheckBox" name="suppress_check">
       <property name="text"><string>Ignore a sensor while its chamber is at/above</string></property>
       <property name="whatsThis"><string>Last-resort fallback: instead of compensating, blank a sensor entirely while a strongly-coupled chamber is this inflated (or this deep in vacuum). Use only if compensation alone is not enough.</string></property>
      </widget>
     </item>
     <item>
      <widget class="QSpinBox" name="suppress_spin">
       <property name="minimum"><number>1</number></property>
       <property name="maximum"><number>100</number></property>
       <property name="suffix"><string> %</string></property>
       <property name="value"><number>90</number></property>
       <property name="enabled"><bool>false</bool></property>
      </widget>
     </item>
     <item>
      <spacer name="suppress_spacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
    </layout>
   </item>
   <item>
    <layout class="QHBoxLayout" name="button_row">
     <item>
      <widget class="QPushButton" name="run_btn">
       <property name="text"><string>Run sweep</string></property>
       <property name="whatsThis"><string>Inflate each chamber in turn and measure its effect on every sensor. Do not touch the skin during the sweep.</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="stop_btn">
       <property name="text"><string>⏹ Stop</string></property>
       <property name="whatsThis"><string>Abort the sweep and halt every chamber (close valves, pumps off).</string></property>
      </widget>
     </item>
     <item>
      <spacer name="button_spacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="apply_btn">
       <property name="text"><string>Apply</string></property>
       <property name="whatsThis"><string>Store the measured coupling matrix (and the chosen settings) onto the skin without closing this window, so you can adjust the threshold or re-run the sweep. Same as Save but leaves the dialog open.</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="save_btn">
       <property name="text"><string>Save</string></property>
       <property name="default"><bool>true</bool></property>
       <property name="whatsThis"><string>Store the measured coupling matrix (and the chosen settings) onto the skin and close this window.</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
