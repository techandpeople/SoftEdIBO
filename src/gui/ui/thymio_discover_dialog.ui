<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ThymioDiscoverDialog</class>
 <widget class="QDialog" name="ThymioDiscoverDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>420</width><height>360</height></rect>
  </property>
  <property name="windowTitle"><string>Discover Thymios</string></property>
  <property name="whatsThis"><string>Finds the 802.15.4 addresses of the Thymio robots over the air — no dongle needed. The gateway's C6 asks the network who is there (it broadcasts a LIST_NODES query, exactly like the dongle) and every powered robot answers with its address. Just have the robots switched on; they need not move. Only robots already paired to this network reply.</string></property>
  <layout class="QVBoxLayout" name="main_layout">
   <item>
    <widget class="QLabel" name="instructions_label">
     <property name="text"><string>&lt;b&gt;Switch each Thymio ON&lt;/b&gt; — the gateway asks the network who is there and every powered robot answers with its address. No dongle needed, and the robots need not move.&lt;br&gt;&lt;br&gt;Turning robots on &lt;b&gt;one at a time&lt;/b&gt; tells you which address is which: they are listed in the order they appear.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>
   <item>
    <widget class="QListWidget" name="addr_list">
     <property name="whatsThis"><string>The Thymio addresses seen so far, in the order they first appeared. Pick this robot's address and press OK (or double-click it).</string></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="status_label">
     <property name="text"><string>Scanning…</string></property>
     <property name="styleSheet"><string>color: palette(mid);</string></property>
     <property name="whatsThis"><string>Scan progress: time left and how many Thymios have been seen.</string></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="button_row">
     <item>
      <widget class="QPushButton" name="rescan_btn">
       <property name="text"><string>Scan again</string></property>
       <property name="whatsThis"><string>Clear the list and run another scan — e.g. to power the robots on in a different order.</string></property>
      </widget>
     </item>
     <item>
      <spacer name="button_spacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QDialogButtonBox" name="button_box">
       <property name="standardButtons"><set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
