    <widget class="QGroupBox" name="turtle_group">
     <property name="title"><string>Turtles</string></property>
     <property name="whatsThis"><string>Configured Turtle robots and their skins/nodes. A Turtle is one shared body whose chambers the whole group interacts with. Expand a robot to edit its skins, or use the row actions to test and configure it.</string></property>
     <layout class="QVBoxLayout" name="turtle_layout">
      <item>
