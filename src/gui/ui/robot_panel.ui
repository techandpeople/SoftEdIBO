  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QGroupBox" name="gateway_group">
     <property name="title"><string>SoftEdIBO Gateway</string></property>
     <property name="whatsThis"><string>The USB gateway board that bridges this PC to the wireless nodes over ESP-NOW. Connect it before configuring robots or starting a session.</string></property>
     <layout class="QHBoxLayout" name="gateway_layout">
      <item>
       <widget class="QComboBox" name="port_combo">
        <property name="whatsThis"><string>Serial port the gateway board is plugged into. Use the (re) button to rescan if it is missing.</string></property>
        <property name="minimumWidth"><number>140</number></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="refresh_ports_btn">
        <property name="text"><string>(re)</string></property>
        <property name="maximumWidth"><number>28</number></property>
        <property name="toolTip"><string>Refresh serial port list</string></property>
       </widget>
      </item>
      <item>
       <widget class="QComboBox" name="baud_rate_combo">
        <property name="whatsThis"><string>Serial speed for the gateway link. Must match the firmware (921600 for the current gateway). Change only if you know the board uses a different rate.</string></property>
        <item><property name="text"><string>9600</string></property></item>
        <item><property name="text"><string>57600</string></property></item>
        <item><property name="text"><string>115200</string></property></item>
        <item><property name="text"><string>921600</string></property></item>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="gateway_status_label">
        <property name="text"><string>Disconnected</string></property>
       </widget>
      </item>
      <item>
       <spacer name="gateway_spacer">
