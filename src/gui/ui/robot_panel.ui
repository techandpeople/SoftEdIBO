        <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
       </spacer>
      </item>
      <item>
       <widget class="QPushButton" name="connect_btn">
        <property name="whatsThis"><string>Open (or close) the serial link to the gateway on the selected port. Most other actions stay disabled until this succeeds.</string></property>
        <property name="text"><string>Connect</string></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="scan_btn">
        <property name="whatsThis"><string>Ask the gateway which nodes are reachable over ESP-NOW right now. Use it to confirm a board is powered and in range before assigning it to a robot.</string></property>
        <property name="text"><string>Scan Nodes</string></property>
        <property name="enabled"><bool>false</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="serial_monitor_btn">
        <property name="whatsThis"><string>Open a raw serial debugging terminal showing live traffic to and from the gateway, with an input box for sending arbitrary lines.</string></property>
        <property name="text"><string>Serial Monitor...</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
