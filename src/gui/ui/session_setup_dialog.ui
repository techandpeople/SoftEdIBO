<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SessionSetupDialog</class>
 <widget class="QDialog" name="SessionSetupDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>420</width><height>520</height></rect>
  </property>
  <property name="windowTitle"><string>New Session</string></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QGroupBox" name="config_group">
     <property name="title"><string>Session</string></property>
     <layout class="QFormLayout" name="formLayout">
      <item row="0" column="0">
       <widget class="QLabel" name="label_session_id">
        <property name="text"><string>Session ID:</string></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="session_id_input">
        <property name="whatsThis"><string>Auto-generated unique ID for this session. Read-only; used to label the recorded data.</string></property>
        <property name="readOnly"><bool>true</bool></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="label_activity">
        <property name="text"><string>Activity:</string></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QComboBox" name="activity_combo">
        <property name="whatsThis"><string>The activity (behaviour) to run this session. Activities are authored per skin set (Natural / Wrinkles / Organs) in the Activity Editor and run on any robot - robot-specific parts are handled by the behaviour's "if robot is..." blocks.</string></property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="label_target_skin">
        <property name="text"><string>Target skin:</string></property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QLabel" name="target_skin_label">
        <property name="text"><string>-</string></property>
        <property name="whatsThis"><string>The skin set this activity was written for. Robots dressed in different skins can still run it, but a warning is shown below the robot list.</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="robots_group">
     <property name="title"><string>Select robots</string></property>
     <property name="whatsThis"><string>Tick the robots taking part. Every configured robot is listed with a live status: Online (all of its nodes answered the scan), Partial (only some did), Ready (a wireless Thymio whose transport is up) or Offline.</string></property>
     <layout class="QVBoxLayout" name="robots_layout">
      <item>
       <widget class="QLabel" name="no_robots_label">
        <property name="text"><string>No robots configured.</string></property>
        <property name="alignment"><set>Qt::AlignCenter</set></property>
       </widget>
      </item>
      <item>
       <widget class="QListWidget" name="robots_list">
        <property name="visible"><bool>false</bool></property>
        <property name="selectionMode">
         <enum>QAbstractItemView::SelectionMode::MultiSelection</enum>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="skin_warning_label">
        <property name="text"><string/></property>
        <property name="visible"><bool>false</bool></property>
        <property name="wordWrap"><bool>true</bool></property>
        <property name="styleSheet"><string notr="true">color: #b36b00;</string></property>
        <property name="whatsThis"><string>Warns when a ticked robot's configured skin variants do not match the activity's target skin (e.g. an Organs activity with a robot dressed in Natural). The session can still start - fix the robot's skin config or swap the physical skins if this is not intended.</string></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QGroupBox" name="participants_group">
     <property name="title"><string>Participants</string></property>
     <property name="whatsThis"><string>Tick the participants taking part in this session. Manage the list in the Participants tab; the session data is linked to whoever you select here.</string></property>
     <layout class="QVBoxLayout" name="participants_layout">
      <item>
       <widget class="QLabel" name="no_participants_label">
        <property name="text"><string>No participants registered.</string></property>
        <property name="alignment"><set>Qt::AlignCenter</set></property>
        <property name="visible"><bool>false</bool></property>
       </widget>
      </item>
      <item>
       <widget class="QListWidget" name="participants_list"/>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="button_box">
     <property name="standardButtons">
      <set>QDialogButtonBox::StandardButton::Cancel|QDialogButtonBox::StandardButton::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections/>
</ui>
