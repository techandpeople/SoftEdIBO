     </item>
     <item>
      <widget class="QPushButton" name="pause_btn">
       <property name="whatsThis"><string>Hold all chambers at their current pressure and pause the activity. Press again to resume. Useful to step in safely mid-session.</string></property>
       <property name="text"><string>Pause</string></property>
       <property name="enabled"><bool>false</bool></property>
