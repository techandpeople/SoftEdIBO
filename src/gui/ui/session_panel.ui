       <property name="whatsThis"><string>End the session, deflate the chambers and save the recorded data. The session is then available in the Data tab.</string></property>
       <property name="text"><string>Stop Session</string></property>
       <property name="enabled"><bool>false</bool></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="observer_btn">
       <property name="whatsThis"><string>Reopen the live-coding window for this session's participants. Use it if you closed that window by accident; observations and markers keep logging to the same session.</string></property>
       <property name="text"><string>Live Coding</string></property>
       <property name="enabled"><bool>false</bool></property>
