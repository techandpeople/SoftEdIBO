<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>GatewayApDialog</class>
 <widget class="QDialog" name="GatewayApDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>460</width><height>300</height></rect>
  </property>
  <property name="windowTitle"><string>Gateway WiFi Access Point</string></property>
  <property name="whatsThis"><string>Configures the WiFi network the gateway broadcasts for the Thymio robots. Only works when the gateway is connected and running the access-point firmware build. The name and password are stored on the gateway itself and survive reboots.</string></property>
  <layout class="QVBoxLayout" name="main_layout">
   <item>
    <widget class="QLabel" name="status_label">
     <property name="text"><string>Reading current settings from the gateway…</string></property>
     <property name="wordWrap"><bool>true</bool></property>
     <property name="whatsThis"><string>Shows the gateway connection state and the result of reading or saving the access-point settings.</string></property>
    </widget>
   </item>
   <item>
    <layout class="QFormLayout" name="form_layout">
     <item row="0" column="0">
      <widget class="QLabel" name="ssid_label">
       <property name="text"><string>Network name (SSID):</string></property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QLineEdit" name="ssid_edit">
       <property name="maxLength"><number>32</number></property>
       <property name="whatsThis"><string>The name of the WiFi network the Thymio robots will see and join. 1 to 32 characters.</string></property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="pass_label">
       <property name="text"><string>Password:</string></property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QLineEdit" name="pass_edit">
       <property name="maxLength"><number>63</number></property>
       <property name="echoMode"><enum>QLineEdit::Password</enum></property>
       <property name="whatsThis"><string>New WiFi password (WPA2, at least 8 characters). Leave blank to keep the current password unchanged.</string></property>
      </widget>
     </item>
     <item row="2" column="1">
      <widget class="QCheckBox" name="show_pass_check">
       <property name="text"><string>Show password</string></property>
       <property name="whatsThis"><string>Reveal the typed password instead of masking it.</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="note_label">
     <property name="text"><string>Stored on the gateway and applied immediately. Connected robots will briefly drop and must rejoin the renamed network. The WiFi channel is fixed to match the nodes and is not changed here.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
     <property name="styleSheet"><string>color: palette(mid);</string></property>
    </widget>
   </item>
   <item>
    <spacer name="vspacer">
     <property name="orientation"><enum>Qt::Vertical</enum></property>
     <property name="sizeHint" stdset="0"><size><width>20</width><height>20</height></size></property>
    </spacer>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="button_box">
     <property name="standardButtons"><set>QDialogButtonBox::Close|QDialogButtonBox::Save</set></property>
    </widget>
   </item>
  </layout>
 </widget>
