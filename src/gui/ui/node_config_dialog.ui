<ui version="4.0">
 <class>NodeConfigDialog</class>
 <widget class="QDialog" name="NodeConfigDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>360</width><height>420</height></rect>
  </property>
  <property name="windowTitle"><string>Configure Node</string></property>
  <property name="minimumSize">
   <size><width>320</width><height>0</height></size>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <layout class="QFormLayout" name="form">
     <item row="0" column="0">
      <widget class="QLabel" name="mac_label">
       <property name="text"><string>Node MAC:</string></property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QLineEdit" name="mac_edit">
       <property name="whatsThis"><string>The node's ESP-NOW MAC address. This is how the gateway addresses the board; it must match the MAC the firmware prints on boot.</string></property>
       <property name="placeholderText"><string>AA:BB:CC:DD:EE:FF</string></property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="type_label">
       <property name="text"><string>Node type:</string></property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QComboBox" name="type_combo">
       <property name="whatsThis"><string>Board type: node_direct (3 chambers, onboard pumps), node_multiplexed (up to 12 chambers) or node_magnet_sensor (4 touch sensors, no actuation). Sets the slot count and which firmware to flash.</string></property>
      </widget>
     </item>
     <item row="2" column="0">
      <widget class="QLabel" name="slots_label">
       <property name="text"><string>Max slots:</string></property>
      </widget>
     </item>
     <item row="2" column="1">
      <widget class="QSpinBox" name="slots_spin">
       <property name="whatsThis"><string>How many chamber slots this node exposes. Fixed for node_direct (3) and node_magnet_sensor (4); up to 16 for node_multiplexed (default 12).</string></property>
       <property name="minimum"><number>0</number></property>
       <property name="maximum"><number>64</number></property>
       <property name="suffix"><string> slots</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="note_lbl">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="styleSheet"><string>color: gray; font-size: 10px;</string></property>
     <property name="text"><string/></property>
    </widget>
   </item>
   <item>
    <layout class="QVBoxLayout" name="btn_layout">
     <item>
      <widget class="QPushButton" name="save_btn">
       <property name="whatsThis"><string>Write this node to settings.yaml. Multiplexed nodes are re-sent their configure command so the firmware chamber count matches.</string></property>
       <property name="text"><string>Save</string></property>
       <property name="default"><bool>true</bool></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="cancel_btn">
       <property name="text"><string>Cancel</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="delete_btn">
       <property name="whatsThis"><string>Remove this node from the configuration. Skins that reference it will need re-pointing to another node.</string></property>
       <property name="text"><string>Delete Node</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
