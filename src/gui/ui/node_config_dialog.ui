<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>NodeConfigDialog</class>
 <widget class="QDialog" name="NodeConfigDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>360</width><height>420</height></rect>
  </property>
  <property name="windowTitle"><string>Configure Node</string></property>
  <property name="minimumSize">
   <size><width>320</width><height>0</height></size>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <layout class="QFormLayout" name="form">
     <item row="0" column="0">
      <widget class="QLabel" name="mac_label">
       <property name="text"><string>Node MAC:</string></property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QLineEdit" name="mac_edit">
       <property name="whatsThis"><string>The node's ESP-NOW MAC address. This is how the gateway addresses the board; it must match the MAC the firmware prints on boot.</string></property>
       <property name="placeholderText"><string>AA:BB:CC:DD:EE:FF</string></property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="type_label">
       <property name="text"><string>Node type:</string></property>
      </widget>
     </item>
     <item row="1" column="1">
      <widget class="QComboBox" name="type_combo">
       <property name="whatsThis"><string>Board type: node_direct (3 chambers, onboard pumps), node_multiplexed (up to 12 chambers, optional shared tanks) or node_magnet_sensor (4 touch sensors, no actuation). Sets the slot count and which firmware to flash.</string></property>
      </widget>
     </item>
     <item row="2" column="0">
      <widget class="QLabel" name="slots_label">
       <property name="text"><string>Max slots:</string></property>
      </widget>
     </item>
     <item row="2" column="1">
      <widget class="QSpinBox" name="slots_spin">
       <property name="whatsThis"><string>How many chamber slots this node exposes. Fixed for node_direct (3) and node_magnet_sensor (4); up to 16 for node_multiplexed (default 12).</string></property>
       <property name="minimum"><number>0</number></property>
       <property name="maximum"><number>64</number></property>
       <property name="suffix"><string> slots</string></property>
      </widget>
     </item>
     <item row="3" column="0">
      <widget class="QLabel" name="reservoirs_label">
       <property name="text"><string>Reservoirs:</string></property>
      </widget>
     </item>
     <item row="3" column="1">
      <widget class="QCheckBox" name="reservoirs_chk">
       <property name="whatsThis"><string>Only for node_multiplexed. Tick if the board has the shared pressure + vacuum tanks driven by onboard pumps. When off, chambers are valved directly and the reservoir limits below are ignored.</string></property>
       <property name="text"><string>Has shared pressure / vacuum reservoirs</string></property>
      </widget>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QGroupBox" name="tank_group">
     <property name="title"><string>Reservoir limits (kPa)</string></property>
     <property name="whatsThis"><string>Operating band for the shared tanks (node_multiplexed with reservoirs). Pressure tank is positive kPa; vacuum tank is negative (min = deepest vacuum, max = closest to atmosphere). Target is the set-point the pumps maintain.</string></property>
     <layout class="QFormLayout" name="tank_form">
      <item row="0" column="0">
       <widget class="QLabel" name="tank_pressure_min_label">
        <property name="text"><string>Pressure tank min (kPa):</string></property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QDoubleSpinBox" name="tank_pressure_min_kpa">
        <property name="whatsThis"><string>Lowest the pressure tank is allowed to fall to before pumps must refill it.</string></property>
        <property name="decimals"><number>1</number></property>
        <property name="minimum"><double>-80.000000000000000</double></property>
        <property name="maximum"><double>80.000000000000000</double></property>
        <property name="singleStep"><double>0.500000000000000</double></property>
        <property name="suffix"><string> kPa</string></property>
        <property name="value"><double>0.000000000000000</double></property>
       </widget>
      </item>
      <item row="1" column="0">
       <widget class="QLabel" name="tank_pressure_max_label">
        <property name="text"><string>Pressure tank max (kPa):</string></property>
       </widget>
      </item>
      <item row="1" column="1">
       <widget class="QDoubleSpinBox" name="tank_pressure_max_kpa">
        <property name="whatsThis"><string>Hard ceiling for the pressure tank; pumps never push it past this (firmware caps at 80 kPa).</string></property>
        <property name="decimals"><number>1</number></property>
        <property name="minimum"><double>-80.000000000000000</double></property>
        <property name="maximum"><double>80.000000000000000</double></property>
        <property name="singleStep"><double>0.500000000000000</double></property>
        <property name="suffix"><string> kPa</string></property>
        <property name="value"><double>50.000000000000000</double></property>
       </widget>
      </item>
      <item row="2" column="0">
       <widget class="QLabel" name="tank_pressure_target_label">
        <property name="text"><string>Pressure tank target (kPa):</string></property>
       </widget>
      </item>
      <item row="2" column="1">
       <widget class="QDoubleSpinBox" name="tank_pressure_target_kpa">
        <property name="whatsThis"><string>Operating set-point the pumps maintain for the pressure tank. Should sit between min and max.</string></property>
        <property name="decimals"><number>1</number></property>
        <property name="minimum"><double>-80.000000000000000</double></property>
        <property name="maximum"><double>80.000000000000000</double></property>
        <property name="singleStep"><double>0.500000000000000</double></property>
        <property name="suffix"><string> kPa</string></property>
        <property name="value"><double>25.000000000000000</double></property>
       </widget>
      </item>
      <item row="3" column="0">
       <widget class="QLabel" name="tank_vacuum_min_label">
        <property name="text"><string>Vacuum tank min (kPa):</string></property>
       </widget>
      </item>
      <item row="3" column="1">
       <widget class="QDoubleSpinBox" name="tank_vacuum_min_kpa">
        <property name="whatsThis"><string>Deepest vacuum allowed (most negative kPa). The pump stops pulling past this.</string></property>
        <property name="decimals"><number>1</number></property>
        <property name="minimum"><double>-80.000000000000000</double></property>
        <property name="maximum"><double>80.000000000000000</double></property>
        <property name="singleStep"><double>0.500000000000000</double></property>
        <property name="suffix"><string> kPa</string></property>
        <property name="value"><double>-50.000000000000000</double></property>
       </widget>
      </item>
      <item row="4" column="0">
       <widget class="QLabel" name="tank_vacuum_max_label">
        <property name="text"><string>Vacuum tank max (kPa):</string></property>
       </widget>
      </item>
      <item row="4" column="1">
       <widget class="QDoubleSpinBox" name="tank_vacuum_max_kpa">
        <property name="whatsThis"><string>Shallowest vacuum (closest to atmosphere, near 0). Pumps refill once the tank rises above this.</string></property>
        <property name="decimals"><number>1</number></property>
        <property name="minimum"><double>-80.000000000000000</double></property>
        <property name="maximum"><double>80.000000000000000</double></property>
        <property name="singleStep"><double>0.500000000000000</double></property>
        <property name="suffix"><string> kPa</string></property>
        <property name="value"><double>0.000000000000000</double></property>
       </widget>
      </item>
      <item row="5" column="0">
       <widget class="QLabel" name="tank_vacuum_target_label">
        <property name="text"><string>Vacuum tank target (kPa):</string></property>
       </widget>
      </item>
      <item row="5" column="1">
       <widget class="QDoubleSpinBox" name="tank_vacuum_target_kpa">
        <property name="whatsThis"><string>Operating set-point for the vacuum tank (negative kPa), between min and max.</string></property>
        <property name="decimals"><number>1</number></property>
        <property name="minimum"><double>-80.000000000000000</double></property>
        <property name="maximum"><double>80.000000000000000</double></property>
        <property name="singleStep"><double>0.500000000000000</double></property>
        <property name="suffix"><string> kPa</string></property>
        <property name="value"><double>-25.000000000000000</double></property>
       </widget>
      </item>
     </layout>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="note_lbl">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="styleSheet"><string>color: gray; font-size: 10px;</string></property>
     <property name="text"><string/></property>
    </widget>
   </item>
   <item>
    <layout class="QVBoxLayout" name="btn_layout">
     <item>
      <widget class="QPushButton" name="save_btn">
       <property name="whatsThis"><string>Write this node to settings.yaml. Multiplexed nodes are re-sent their configure command so the firmware tank targets match.</string></property>
       <property name="text"><string>Save</string></property>
       <property name="default"><bool>true</bool></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="cancel_btn">
       <property name="text"><string>Cancel</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="delete_btn">
       <property name="whatsThis"><string>Remove this node from the configuration. Skins that reference it will need re-pointing to another node.</string></property>
       <property name="text"><string>Delete Node</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
