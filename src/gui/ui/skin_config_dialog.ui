   </item>
   <item>
    <layout class="QHBoxLayout" name="btn_row">
     <item>
      <widget class="QPushButton" name="test_btn">
       <property name="whatsThis"><string>Open the actuator tester to inflate/deflate each chamber of this skin and confirm the wiring matches the layout.</string></property>
       <property name="text"><string>Test Actuators</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="calib_btn">
       <property name="toolTip"><string>Measure this skin's chamber fill times against the pressure sensor.</string></property>
       <property name="text"><string>Calibrate Fill</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="zero_btn">
       <property name="toolTip"><string>Vent this skin's chambers to atmosphere, then zero their pressure sensors so ambient reads 0 kPa (persisted on the node).</string></property>
       <property name="whatsThis"><string>The pressure sensor has no factory zero, so at true atmosphere it reads a few kPa of offset — which makes a vented chamber look inflated. This vents every chamber to ambient (valves open, pumps off) and tells the node to capture that reading as its per-chamber zero, stored in flash. Run it once (with the skin idle, nothing pressing) after wiring or swapping a sensor. Note: afterwards pressure targets are true gauge, so chambers reach a few kPa higher for the same setpoint.</string></property>
       <property name="text"><string>Zero Sensors</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="delete_btn">
       <property name="whatsThis"><string>Remove this skin from the configuration. Does not touch the node hardware; other skins on the same node are unaffected.</string></property>
       <property name="text"><string>Delete Skin</string></property>
      </widget>
     </item>
     <item>
      <spacer name="btn_spacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
      </spacer>
     </item>
     <item>
      <widget class="QPushButton" name="cancel_btn">
       <property name="text"><string>Cancel</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="apply_btn">
       <property name="whatsThis"><string>Save this skin to settings.yaml without closing the dialog, so you can keep tweaking the pressure limits and re-test the actuators. Same as Save but leaves the dialog open.</string></property>
       <property name="text"><string>Apply</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="save_btn">
       <property name="whatsThis"><string>Write this skin to settings.yaml. Pressure limits are pushed to the node so chambers stay protected even if the PC disconnects.</string></property>
       <property name="text"><string>Save</string></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
