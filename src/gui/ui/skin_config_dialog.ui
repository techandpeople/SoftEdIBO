      <widget class="QWidget" name="left_panel" native="true">
       <layout class="QVBoxLayout" name="left_layout">
        <property name="leftMargin"><number>0</number></property>
        <property name="topMargin"><number>0</number></property>
        <property name="rightMargin"><number>0</number></property>
        <property name="bottomMargin"><number>0</number></property>
        <item>
         <layout class="QFormLayout" name="form">
          <item row="0" column="0">
           <widget class="QLabel" name="skin_id_label">
            <property name="text"><string>Skin ID:</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QLineEdit" name="skin_id_edit">
            <property name="whatsThis"><string>Unique identifier for this skin, used in settings.yaml and to route touches/activities. Lowercase, no spaces (e.g. belly).</string></property>
            <property name="placeholderText"><string>e.g. belly</string></property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="skin_type_label">
            <property name="text"><string>Skin type:</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QComboBox" name="skin_type_combo">
            <property name="toolTip"><string>Skin type for this robot. Determines the shape and sensor layout (from src/hardware/skin_geometry.py) and selects the touch-gesture model.</string></property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="skin_variant_label">
            <property name="text"><string>Silicone:</string></property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QComboBox" name="skin_variant_combo">
            <property name="toolTip"><string>Silicone format of this skin (different chamber sizes per variant). Used as a touch-gesture ML feature.</string></property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QLabel" name="chambers_label">
          <property name="whatsThis"><string>The chambers that make up this skin. Each row binds a node slot to a max/min pressure and an optional fill time. The live layout preview is on the right.</string></property>
          <property name="text"><string>Chambers:</string></property>
         </widget>
        </item>
