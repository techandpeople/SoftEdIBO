          <property name="maximumSize">
           <size><width>16777215</width><height>160</height></size>
          </property>
          <property name="widgetResizable"><bool>true</bool></property>
          <widget class="QWidget" name="rows_container">
           <layout class="QVBoxLayout" name="rows_layout">
            <property name="leftMargin"><number>0</number></property>
            <property name="topMargin"><number>0</number></property>
            <property name="rightMargin"><number>0</number></property>
            <property name="bottomMargin"><number>0</number></property>
            <property name="spacing"><number>3</number></property>
           </layout>
          </widget>
         </widget>
        </item>
        <item>
         <widget class="QPushButton" name="add_chamber_btn">
          <property name="whatsThis"><string>Add a new chamber row to this skin. Set its node slot and pressure limits, then place it in the layout on the right.</string></property>
          <property name="text"><string>+ Add Chamber</string></property>
         </widget>
