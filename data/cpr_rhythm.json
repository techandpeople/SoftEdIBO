{
  "format": "softedibo.activity",
  "version": 1,
  "name": "CPR Rhythm",
    "description": "Three participants make consecutive, synchronized compression rounds at a steady cadence.",
  "spec": {
    "initial": "listening",
    "states": {
      "listening": {
        "do": [
          {
            "set_led": {
              "color": "#f39c12",
              "pattern": "pulse",
              "period_ms": 900
            }
          }
        ],
        "transitions": [
          {
            "to": "complete",
            "when": {
              "group_touch_sync": {
                "participants": 3,
                "sensors": [0, 1, 2],
                "target_interval_ms": 550,
                "cadence_tolerance_ms": 100,
                "phase_tolerance_ms": 150,
                "min_gap_ms": 250,
                "rounds": 6
              }
            }
          }
        ]
      },
      "complete": {
        "do": [
          {
            "set_led": {
              "color": "#2ecc71",
              "pattern": "solid"
            }
          }
        ],
        "transitions": []
      }
    }
  }
}
