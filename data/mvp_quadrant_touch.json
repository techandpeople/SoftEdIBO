{
  "format": "softedibo.activity",
  "version": 1,
  "name": "MVP - quadrant touch lights",
  "description": "Whole strip starts purple. Every press lights a few random pixels of the LED quadrant above the touched sensor in yellow; pressing another part of the skin starts lighting that quadrant too. Nothing else happens - a pure visual demo.",
  "spec": {
    "initial": "touch",
    "states": {
      "touch": {
        "do": [
          {
            "when": {
              "event": "touch",
              "do": [
                {
                  "zone_light": {
                    "kind": "touch",
                    "step_pct": 20,
                    "target_interval_ms": 550,
                    "tolerance_ms": 150,
                    "min_gap_ms": 250,
                    "fill": "random",
                    "on_color": "#f1c40f",
                    "bg_color": "#8e44ad",
                    "fade_ms": 250,
                    "ring": "all"
                  }
                }
              ]
            }
          },
          {
            "hold_feedback": {
              "hold": "glow",
              "hold_full_ut": 300,
              "on_color": "#f1c40f",
              "bg_color": "#8e44ad",
              "fade_ms": 250,
              "ring": "all"
            }
          },
          {
            "set_led": {
              "color": "#8e44ad",
              "pattern": "solid",
              "period_ms": 0,
              "fade_ms": 250,
              "angle": 0,
              "ring": "all"
            }
          }
        ],
        "transitions": []
      }
    }
  }
}
