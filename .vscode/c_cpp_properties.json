{
    "configurations": [
        {
            "name": "SoftEdIBO firmware (all)",
            "compilerPath": "${env:HOME}/.platformio/packages/toolchain-xtensa-esp32/bin/xtensa-esp32-elf-g++",
            "includePath": [
                "${workspaceFolder}/firmware/common",
                "${workspaceFolder}/firmware/node_actuator/src/direct",
                "${workspaceFolder}/firmware/node_actuator/src/multiplexed",
                "${workspaceFolder}/firmware/node_magnet_sensor/src",
                "${workspaceFolder}/firmware/gateway/src",
                "${workspaceFolder}/firmware/*/include",
                "${workspaceFolder}/firmware/*/.pio/libdeps/**",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/cores/esp32",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/variants/esp32",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/libraries/**",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32/include/**"
            ],
            "defines": [
                "PLATFORMIO=60118",
                "ARDUINO=10813",
                "ARDUINO_ARCH_ESP32",
                "ESP32",
                "DEBUG_BUILD",
                "NODE_DIRECT"
            ],
            "cStandard": "c17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x64"
        },
        {
            "name": "Node Actuator (direct)",
            "compilerPath": "${env:HOME}/.platformio/packages/toolchain-xtensa-esp32/bin/xtensa-esp32-elf-g++",
            "includePath": [
                "${workspaceFolder}/firmware/common",
                "${workspaceFolder}/firmware/node_actuator/src/direct",
                "${workspaceFolder}/firmware/node_actuator/.pio/libdeps/**",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/cores/esp32",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/variants/esp32",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/libraries/**",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32/include/**"
            ],
            "defines": [
                "PLATFORMIO=60118",
                "ARDUINO=10813",
                "ARDUINO_ARCH_ESP32",
                "ESP32",
                "DEBUG_BUILD",
                "NODE_DIRECT"
            ],
            "cStandard": "c17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x64"
        },
        {
            "name": "Node Actuator (multiplexed)",
            "compilerPath": "${env:HOME}/.platformio/packages/toolchain-xtensa-esp32/bin/xtensa-esp32-elf-g++",
            "includePath": [
                "${workspaceFolder}/firmware/common",
                "${workspaceFolder}/firmware/node_actuator/src/multiplexed",
                "${workspaceFolder}/firmware/node_actuator/.pio/libdeps/**",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/cores/esp32",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/variants/esp32",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/libraries/**",
                "${env:HOME}/.platformio/packages/framework-arduinoespressif32/tools/sdk/esp32/include/**"
            ],
            "defines": [
                "PLATFORMIO=60118",
                "ARDUINO=10813",
                "ARDUINO_ARCH_ESP32",
                "ESP32",
                "DEBUG_BUILD",
                "NODE_MULTIPLEXED"
            ],
            "cStandard": "c17",
            "cppStandard": "gnu++17",
            "intelliSenseMode": "linux-gcc-x64"
